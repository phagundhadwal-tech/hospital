# CarePulse – backend environment variables
# Copy this file to  backend/.env  and edit the values.  NEVER commit .env.

# ── JWT authentication ────────────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_STRONG_64_CHARACTER_SECRET_DO_NOT_USE_THIS_VALUE_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── SQL Server connection (pick ONE of the DATABASE_URL lines) ────────────────
# Write the value on one line, WITHOUT quotes.
#
# A) Windows login (the same login you use in SSMS), local default instance:
DATABASE_URL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=CarePulseDB;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
#
# B) Windows login, named instance (e.g. SQL Server Express):
# DATABASE_URL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=CarePulseDB;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes
#
# C) SQL login (user name + password). These are the same credentials QUICKSTART.md
#    step 4 creates (login "carepulse"); change the password in BOTH places.
#    Default instance: use SERVER=localhost.
# DATABASE_URL=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost\SQLEXPRESS;DATABASE=CarePulseDB;UID=carepulse;PWD=ChangeMe!Str0ngPass;Encrypt=yes;TrustServerCertificate=yes
#
# D) SQLAlchemy URL form (same credentials; "!" must be URL-encoded as %21):
# DATABASE_URL=mssql+pyodbc://carepulse:ChangeMe%21Str0ngPass@localhost\SQLEXPRESS/CarePulseDB?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#
# TrustServerCertificate=yes accepts a self-signed certificate. That is fine for a
# development PC; on a production server install a trusted certificate and REMOVE it.

# If your tables already exist under different names/schema, tell the API:
DB_SCHEMA=dbo
# e.g. DB_TABLE_SUFFIX=_V6 if your tables are named PATIENT_VISITS_V6, BEDS_V6, ...
DB_TABLE_SUFFIX=

# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10

# ── Login user store (created by python data/create_demo_users.py) ────────────
USERS_CSV_PATH=data/users.csv

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── Application / request handling (all optional; defaults shown) ─────────────
# APP_TITLE=CarePulse Hospital Management API
# APP_VERSION=1.0.0
# API_PREFIX=/api
# LOG_LEVEL=INFO
# BCRYPT_ROUNDS=12
# DATE_FORMAT=%Y-%m-%d
# FILTER_TEXT_MAX_LENGTH=40
# Logical -> physical table names (JSON, one line):
# DB_TABLE_NAMES={"Patient_Visits":"visits","Departments":"departments","Patients":"patients","Staff":"staff","Beds":"beds","Wards":"wards","Bed_Assignments":"bed_assignments"}
